# Root ignore for monorepo

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node
node_modules/
**/node_modules/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Builds
build/
dist/
dist-ssr/
**/build/
**/dist/
**/dist-ssr/

# Env & secrets
.env
.env.*
**/.env
**/.env.*
.env.local
**/.env.local

# Misc
*.local

# Project temp artifacts
# Ignore ad-hoc temporary JSON payloads in repo root
tmp_*.json

# Ignore frontend lint output text dumps
frontend/lint*.txt

# Local debug artifacts (do not commit)
backend/cookies.txt
backend/login_response.txt
backend/*response*.txt
backend/build_err_latest.txt
backend/build_log_backend_latest.txt
frontend/build_err.txt
frontend/build_out.txt
frontend/_vite_build_out*.txt
frontend/_vite_build_err*.txt
frontend/_vite_build_*.txt

# Local build/test capture outputs (do not commit)
*_build_out.txt
*_test_out.txt

# Local capture artifacts (.out) (do not commit)
frontend/*.out

# Backend local test capture outputs (do not commit)
backend/test_*.txt
