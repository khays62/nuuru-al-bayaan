###############################################
# Nuuru Al-Bayaan — Frontend ENV Template     #
###############################################

# How to use:
# 1) Copy this file to .env.development for local dev.
# 2) Optionally create .env.production for production builds.
# 3) NEVER put secrets here — these values are public in the browser.

# Development (recommended)
# Use same-origin '/api' so cookie auth works via Vite proxy.
VITE_API_BASE_URL=/api

# Alternative (works too, but cross-origin cookies may require extra care):
# VITE_API_BASE_URL=http://localhost:7000/api

# Optional: Vite dev-server proxy target for /api
# VITE_API_PROXY_TARGET=http://localhost:7000

# Production
# If served behind a reverse proxy (Nginx/Caddy) that forwards /api → backend:
# VITE_API_BASE_URL=/api
# Or use a full domain if needed:
# VITE_API_BASE_URL=https://your-domain.com/api

# Notes:
# - Only variables starting with VITE_ are exposed to the client (Vite behavior).
# - The repo ignores .env files by default; commit this template only.
