# Backend ENV template (NO SECRETS)
# Copy this file to backend/.env and fill in real values.

# Environment
NODE_ENV=development

# Server
PORT=7000

# MongoDB
# Use your own connection string (do NOT commit secrets)
MONG_URL=mongodb://127.0.0.1:27017/nuuru_al_bayaan

# Optional local fallback for SRV DNS failures (see backend/config/db.js)
LOCAL_MONG_URL=mongodb://127.0.0.1:27017/nuuru_al_bayaan

# Auth
# Required in production (long random string)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET

# Default initial passwords (adjust as needed)
# NOTE: these must exist (server validates), and should be changed in production.
DEFAULT_INITIAL_PASSWORD=ChangeMe123!
DEFAULT_TEACHER_PASSWORD=ChangeMe123!
# Optional legacy alias (some scripts/flows may read this)
# DEFAULT_STUDENT_PASSWORD=ChangeMe123!

# CORS (comma-separated allowlist)
# Dev default frontend: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cookies (important for deployment topology)
# strict|lax|none
COOKIE_SAMESITE=strict
# In production with HTTPS set to 1
COOKIE_SECURE=0
# Optional: for subdomain sharing (e.g. .example.com)
# COOKIE_DOMAIN=.example.com

# Reverse proxy (Render/Heroku/Nginx/Cloudflare)
# Set to 1 only when behind a trusted proxy
TRUST_PROXY=0

# Debug/auth (avoid enabling in production)
AUTH_DETAILED_ERRORS=0

# AI (OpenAI-compatible)
# Optional: set AI_BASE_URL only if you are using a non-default OpenAI-compatible endpoint.
# AI_BASE_URL=https://your-openai-compatible-endpoint/v1
# Optional:
# AI_MODEL=gpt-4.1

# One of these is required to enable AI:
# - GITHUB_TOKEN (if using a GitHub Models-compatible gateway)
# - OPENAI_API_KEY (OpenAI)
# GITHUB_TOKEN=PASTE_YOUR_TOKEN_HERE
# OPENAI_API_KEY=PASTE_YOUR_KEY_HERE
